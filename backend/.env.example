# OmniRoute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# Direct Google Gemini
GEMINI_API_KEY=
HELPER_GEMINI_MODEL=gemini-3.1-flash-lite

# Normal Assistant
NORMAL_ASSISTANT_MODEL=auto/best-coding
NORMAL_MAX_OUTPUT_TOKENS=1200
NORMAL_TEMPERATURE=0.2

# Eligibility
ELIGIBILITY_MAX_OUTPUT_TOKENS=1200

# Attack Generation
ATTACK_GENERATION_MAX_OUTPUT_TOKENS=1200

# Semantic Evaluator
EVALUATOR_MAX_OUTPUT_TOKENS=220

# Controlled Experiment
EXPERIMENT_MODEL=gemini/gemini-3.1-flash-lite
EXPERIMENT_TEMPERATURE=0.2
EXPERIMENT_MAX_OUTPUT_TOKENS=800

# Local Application
DATABASE_URL=sqlite:///./promptguard.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000