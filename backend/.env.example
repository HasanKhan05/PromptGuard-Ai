# Local OmniRoute gateway
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# Ordinary assistant routing (auto is fine outside controlled experiments)
NORMAL_ASSISTANT_MODEL=auto/best-coding
NORMAL_MAX_OUTPUT_TOKENS=1200
NORMAL_TEMPERATURE=0.2

# Fixed paired-experiment model; never use auto/... here
EXPERIMENT_MODEL=gemini/gemini-3.1-flash-lite

# Later Codex phases should use compact caps similar to these
ELIGIBILITY_MAX_OUTPUT_TOKENS=1200
ATTACK_GENERATION_MAX_OUTPUT_TOKENS=500
EVALUATOR_MAX_OUTPUT_TOKENS=220
RESEARCH_MAX_OUTPUT_TOKENS=500

# Local app
DATABASE_URL=sqlite:///./promptguard.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
